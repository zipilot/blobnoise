{
  "name": "blobnoise-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @blobnoise/studio --",
    "build:package": "npm run build --workspace blobnoise",
    "build": "npm run build:package && npm run build --workspace @blobnoise/studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "smoke:studio": "node scripts/smoke-studio.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
